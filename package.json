{
  "name": "gemax-td",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "tsc": "tsc --noEmit",
    "test": "jest",
    "test:engine": "vitest run --config vitest.config.ts",
    "test:engine:watch": "vitest --config vitest.config.ts",
    "lint:tsc:engine": "tsc --noEmit -p tsconfig.engine.json",
    "validate:waves": "vitest run --config scripts/vitest.validate-waves.config.ts",
    "gen:icons": "node scripts/gen-icons.mjs",
    "eas:build:dev": "eas build --profile development --platform ios",
    "eas:build:preview:ios": "eas build --profile preview --platform ios",
    "eas:build:preview:android": "eas build --profile preview --platform android",
    "eas:build:prod:ios": "eas build --profile production --platform ios",
    "eas:build:prod:android": "eas build --profile production --platform android",
    "eas:build:prod:all": "eas build --profile production --platform all",
    "eas:submit:ios": "eas submit --platform ios --latest",
    "eas:submit:android": "eas submit --platform android --latest",
    "preflight": "npm run tsc && npm run test:engine && npm run lint:tsc:engine"
  },
  "dependencies": {
    "@expo-google-fonts/epilogue": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "7.0.14",
    "@react-navigation/native-stack": "7.2.0",
    "@shopify/react-native-skia": "2.4.18",
    "expo": "~55.0.0",
    "expo-asset": "~55.0.16",
    "expo-audio": "~55.0.14",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.5",
    "expo-updates": "~55.0.21",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "12.9.0",
    "@tsconfig/strictest": "2.0.5",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@vitest/ui": "2.1.8",
    "babel-plugin-module-resolver": "5.0.2",
    "jest": "29.7.0",
    "jest-expo": "~55.0.16",
    "ts-node": "10.9.2",
    "typescript": "~5.9.2",
    "vitest": "2.1.8"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "private": true
}
